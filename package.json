{
  "name": "crosswalk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-manual.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist",
    "test:backend": "node --experimental-strip-types --test tests/supabase-backend.test.mjs",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "check:edge": "deno check --node-modules-dir=manual --cached-only --config supabase/functions/crosswalk-game/deno.json supabase/functions/crosswalk-game/index.ts",
    "check:engine": "node scripts/verify-engine-copy.mjs",
    "guide:build": "node scripts/build-guide.mjs",
    "guide:check": "node scripts/build-guide.mjs --check",
    "manual:build": "node scripts/build-manual.mjs",
    "manual:check": "node scripts/build-manual.mjs --check"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.59.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "@electric-sql/pglite": "0.5.8",
    "supabase": "2.120.0",
    "deno": "2.9.6",
    "esbuild": "0.28.0"
  },
  "type": "module"
}
