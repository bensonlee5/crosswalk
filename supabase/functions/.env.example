# Edge Function ONLY. Exact production origin, not a URL with /crosswalk/.
CROSSWALK_ALLOWED_ORIGINS=https://YOUR_GITHUB_OWNER.github.io
# Local development, in a separate local .env file:
# CROSSWALK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase. Never send or copy them into frontend files or public repositories.
